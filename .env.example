LINA_ENVIRONMENT=development
LINA_DEBUG=false

# Economic LLM routing. API keys belong in data/private/LLM api key.txt
# or provider-specific LINA_LLM_*_API_KEY environment variables.
LINA_LLM_PROVIDER=auto
LINA_LLM_ALLOW_PAID_FALLBACK=false
LINA_LLM_KEY_FILE="data/private/LLM api key.txt"
LINA_LLM_GROQ_MODEL=qwen/qwen3.6-27b
LINA_LLM_AGNES_MODEL=agnes-2.5-flash
LINA_LLM_NVIDIA_MODEL=qwen/qwen3-next-80b-a3b-instruct
LINA_LLM_DEEPSEEK_MODEL=deepseek-v4-flash
