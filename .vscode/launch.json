{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lina: FastAPI (8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "lina_agent.main:app",
        "--app-dir",
        "src",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Lina: anonymous file Agent",
      "type": "debugpy",
      "request": "launch",
      "module": "lina_agent.cli",
      "args": [
        "--resume",
        "tests/fixtures/resume_anonymized.md",
        "--jobs",
        "tests/fixtures/job_catalog_anonymized.md",
        "--top",
        "3"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Lina: current pytest file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-q"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
